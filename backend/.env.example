# Contoh pengaturan backend NoBaku. SALIN file ini menjadi "backend/.env" lalu isi nilainya.
# "backend/.env" sudah dikecualikan .gitignore — JANGAN pernah meng-commit file .env atau menempel kunci di frontend.

# --- Server ---
# DATABASE_URL=sqlite:///./nobaku.db
# JWT_SECRET=isi-dengan-teks-acak-panjang
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# TEACHER_REQUIRE_APPROVAL=false

# --- Asisten Belajar (Groq) ---
# Mati secara bawaan. Ubah ke true hanya setelah persetujuan orang tua/sekolah untuk uji coba didapat.
AI_ENABLED=false
# Buat API key di https://console.groq.com/keys — kunci hanya disimpan di file .env ini (backend).
GROQ_API_KEY=
# Model produksi Groq; cek daftar terbaru di https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Batas pesan per siswa per hari (di memori server; kembali ke nol saat server dimulai ulang)
AI_DAILY_LIMIT=20
